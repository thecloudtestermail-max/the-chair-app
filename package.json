{
  "name": "chair-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "tsx scripts/init-db.ts",
    "db:create-super-admin": "tsx scripts/create-super-admin.ts",
    "db:create-tenant": "tsx scripts/create-default-tenant.ts",
    "db:migrate": "tsx scripts/migrate-from-sanity.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude e2e/**",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.0.0",
    "mongodb": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^2.30.0",
    "@vercel/blob": "^0.16.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1"
  },
  "overrides": {
  "react-leaflet": { "react": "$react", "react-dom": "$react-dom" },
  "@sanity/icons": { "react": "$react" }
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcryptjs": "^2.4.6",
    "next-sanity": "^7.1.3",
    "tsx": "^4.7.0",
    "vitest": "^2.1.0",
    "@types/leaflet": "^1.9.8",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.2",
    "@playwright/test": "^1.48.0",
    "mongodb-memory-server": "^10.1.2"
  }
}
